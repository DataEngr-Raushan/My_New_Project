    {
      "cell_type": "code",
      "source": [
        "from pyspark.sql import SparkSession\n",
        "\n",
        "if __name__ == '__main__':\n",
        "    spark = SparkSession.builder.master(\"local[2]\").appName(\"pySpark Application\").getOrCreate()\n",
        "    sc = spark.sparkContext\n",
        "\n",
        "    logsRDD=sc.textFile(\"/content/log_file.txt\") # Reading File Path as RDD\n",
        "\n",
        "    header=logsRDD.first() #Exracting header\n",
        "\n",
        "    logsRDD1 = (\n",
        "        logsRDD\n",
        "        .filter(lambda row: row != header) #Remove header\n",
        "        .map(lambda row: row.split(\",\")) # Split line (row)\n",
        "        .map(lambda x: {\n",
        "            \"logdate\": x[0],\n",
        "            \"logtime\": x[1],\n",
        "            \"size\": int(x[2]),\n",
        "            \"r_version\": x[3],\n",
        "            \"r_arch\": x[4],\n",
        "            \"r_os\": x[5],\n",
        "            \"package\": x[6],\n",
        "            \"version\": x[7],\n",
        "            \"country\": x[8],\n",
        "            \"ip_id\": int(x[9])\n",
        "        })\n",
        "    )\n",
        "\n",
        "    # a.\tFind the total number of downloads by country and package\n",
        "\n",
        "    country_packageRDD=logsRDD1.map(lambda row:((row[\"country\"], row[\"package\"]),1))\n",
        "\n",
        "    downloadsRDD = country_packageRDD.reduceByKey( lambda x, y: x + y)\n",
        "\n",
        "\n",
        "    print(downloadsRDD.take(5))\n"
