        "id": "QXHquEaNGGFn"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from pyspark.sql import SparkSession\n",
        "\n",
        "if __name__ == '__main__':\n",
        "    spark = SparkSession.builder.master(\"local[2]\").appName(\"pySpark Application\").getOrCreate()\n",
        "    sc = spark.sparkContext\n",
        "    acc=sc.accumulator(0)\n",
        "\n",
        "    logsRDD=sc.textFile(\"/content/log_file.txt\") # Reading File Path as RDD\n",
        "\n",
        "    header=logsRDD.first() #Exracting header\n",
        "\n",
        "    logsRDD1 = (\n",
        "        logsRDD\n",
        "        .filter(lambda row: row != header) #Remove header\n",
        "        .map(lambda row: row.split(\",\")) # Split line (row)\n",
        "        .map(lambda x: {\n",
        "            \"logdate\": x[0],\n",
        "            \"logtime\": x[1],\n",
        "            \"size\": int(x[2]),\n",
        "            \"r_version\": x[3],\n",
        "            \"r_arch\": x[4],\n",
        "            \"r_os\": x[5],\n",
        "            \"package\": x[6],\n",
        "            \"version\": x[7],\n",
        "            \"country\": x[8],\n",
        "            \"ip_id\": int(x[9])\n",
        "        })\n",
        "    )\n",
        "\n",
        "    def record_count(logsRDD1,acc):\n",
        "      def check_size(record):\n",
        "        if record[\"size\"]>=10000:\n",
        "          acc.add(1)\n",
        "          return record\n",
        "      logsRDD1.foreach(check_size)\n",
        "      return acc.value\n",
        "\n",
        "\n",
        "count = record_count(logsRDD1, acc)\n",
        "\n",
        "print(count)"
      ],
